<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: neither cloud backup nor device-to-device transfer may carry the tailnet
     node key, restoring it elsewhere would clone this node's identity. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="tailnet" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="tailnet" />
    </device-transfer>
</data-extraction-rules>
